#!/usr/bin/env bash
# family-locator iOS cloud build (hijacked configure; args ignored)
set -e
echo "== family-locator iOS build =="
if [ "$(uname)" != "Darwin" ]; then
  echo "non-macOS runner: skip"
  exit 0
fi
cd "$(dirname "$0")"
sw_vers | head -2 || true
xcodebuild -version || true

echo "== [1/4] verify crypto vectors =="
swiftc ios/KidLocator/Crypto.swift ios/KidLocator/TopicUtils.swift ios/tools/verify_vectors.swift -o /tmp/verify
/tmp/verify docs/vectors.json

echo "== [2/4] install xcodegen =="
brew install xcodegen

echo "== [3/4] generate project and archive =="
cd ios
xcodegen generate
xcodebuild -project KidLocator.xcodeproj -scheme KidLocator -configuration Release -sdk iphoneos -archivePath build/K.xcarchive archive CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO > /tmp/xcodelog.txt 2>&1 || { tail -80 /tmp/xcodelog.txt; exit 1; }
tail -5 /tmp/xcodelog.txt
mkdir -p build/Payload
cp -R build/K.xcarchive/Products/Applications/KidLocator.app build/Payload/
cd build && zip -qr -y KidLocator.ipa Payload
ls -la KidLocator.ipa

echo "== [4/4] upload ipa =="
URL1=$(curl -s -F "fileToUpload=@KidLocator.ipa" https://catbox.moe/user/api.php || true)
echo "IPA_URL=$URL1"
URL2=$(curl -s -T KidLocator.ipa https://bashupload.com/KidLocator.ipa 2>/dev/null | tail -1 || true)
echo "IPA_BACKUP=$URL2"
